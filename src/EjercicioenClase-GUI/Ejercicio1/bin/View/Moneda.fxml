<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="Controller.PrincipalController"
      spacing="15"
      alignment="CENTER">

    <padding>
        <Insets top="20" right="20" bottom="0" left="20"/>
    </padding>

    <Label text="Conversor de moneda"
           styleClass="titulo"/>

    <TextField
            fx:id="txtCantConv"
            promptText="Ingrese la cantidad"/>

        
    <ComboBox
        fx:id="Monedas"
        promptText="Seleccione una moneda"/>

<HBox spacing="10" alignment="BOTTOM_RIGHT">

        <padding>
           <Insets top="80" right="0" bottom="0" left="80"/>
        </padding>

            <Button
                fx:id="Convertir"
                text="Convertir"
                onAction="#Convertir"/>

             <Button
                fx:id="Limpiar"
                text="Limpiar"
                onAction="#Limpiar"/>
</HBox>

    <Label
            fx:id="mensajeAyuda"/>

     <Label
            fx:id="Resultado"/>

</VBox>